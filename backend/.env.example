# ==============================================================================
# KanakaDurga FireWorks Backend Environment Configuration
# Location: Attapur, Hyderabad, Telangana, India
# Stack: Python Flask + MongoDB Atlas (PyMongo) + Cash on Delivery (COD)
# ==============================================================================

# Flask Configuration
ENVIRONMENT="development" # Set to 'production' on live deployment
PORT=5000
SECRET_KEY="kanakadurga-fireworks-dev-secret-key-attapur-2026"
JWT_EXPIRY_HOURS=72

# Allowed Frontend Origin for CORS (e.g., http://localhost:3000 or your custom domain)
# Note: Wildcard (*) is not permitted when credentials/authorization headers are sent
FRONTEND_ORIGIN="http://localhost:3000"

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# Use MongoDB Atlas Free Tier (M0 Sandbox) which gives 512MB storage at zero cost.
MONGODB_URI="mongodb+srv://kanakadurga_user:<password>@cluster0.abcde.mongodb.net/kanakadurga_fireworks?retryWrites=true&w=majority"
MONGODB_DATABASE="kanakadurga_fireworks"

# Admin Bootstrap Configuration
# The first admin user with this email or phone is automatically granted the 'admin' role upon bootstrap
ADMIN_BOOTSTRAP_EMAIL="abh1navreddy9095@gmail.com"
ADMIN_BOOTSTRAP_PHONE="+919177416913"
ADMIN_BOOTSTRAP_SECRET="KanakaDurgaFireWorks2026"

# Google Identity Services Authentication (OAuth 2.0 Web Client)
# Create an OAuth client ID at https://console.cloud.google.com/apis/credentials
# The client ID is verified by backend/middleware/auth.py using google.auth.transport
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# Firebase Phone OTP Authentication (Free Tier Spark Plan)
# Configure free SMS phone authentication in Firebase Console -> Authentication
# Download your service account key or provide path/json string:
FIREBASE_PROJECT_ID="kanakadurga-fireworks"
FIREBASE_SERVICE_ACCOUNT_PATH="/path/to/firebase-service-account.json"
# Or provide the JSON string encoded as base64 for cloud environments:
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Cloudinary Product Image Storage (Free Tier - 25 Monthly Credits)
# Sign up at https://cloudinary.com and get credentials from the Dashboard
CLOUDINARY_CLOUD_NAME="kanakadurga-fireworks"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Resend Automatic Email Notifications (Free Tier - 3,000 emails/month, 100/day)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY="re_your_resend_api_key_here"
ADMIN_EMAIL="admin@kanakadurgafireworks.com"
RESEND_FROM_EMAIL="onboarding@resend.dev"
